---
import '../styles/global.css';
import { getSettings } from '../lib/settings';

interface Props {
  title?: string;
  /** Wider main column + tighter vertical padding — for the coach console. */
  wide?: boolean;
}
const { title, wide } = Astro.props;
const { user, profile, embed } = Astro.locals;
const isStaff = profile?.role === 'coach' || profile?.role === 'admin';
const path = Astro.url.pathname;
const { brand } = await getSettings();
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${brand}` : brand}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load fonts without blocking first paint; system-ui shows immediately, swaps in. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@400..700&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body class="flex min-h-full flex-col">
    {!embed && (
    <header class="border-b border-line">
      <nav class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-5 gap-y-1 px-5 py-4">
        <a href="/" class="mr-1 font-display text-lg font-extrabold tracking-tight">{brand}</a>
        <a href="/" class:list={['text-sm hover:text-ink', path === '/' ? 'text-ink' : 'text-ink-soft']}>Book</a>
        {
          user && (
            <a
              href="/bookings"
              class:list={['text-sm hover:text-ink', path === '/bookings' ? 'text-ink' : 'text-ink-soft']}
            >
              My bookings
            </a>
          )
        }
        {
          profile?.role === 'admin' && (
            <a
              href="/admin"
              class:list={['text-sm hover:text-ink', path.startsWith('/admin') ? 'text-ink' : 'text-ink-soft']}
            >
              Admin
            </a>
          )
        }
        {
          isStaff && (
            <a
              href="/coach"
              class:list={['text-sm hover:text-ink', path.startsWith('/coach') ? 'text-ink' : 'text-ink-soft']}
            >
              Coach
            </a>
          )
        }
        <span class="hidden flex-1 sm:block"></span>
        {
          user ? (
            <form method="POST" action="/logout" class="ml-auto sm:ml-0">
              <button class="text-sm text-ink-soft hover:text-ink">Sign out</button>
            </form>
          ) : (
            <a href="/login" class="ml-auto text-sm text-ink-soft hover:text-ink sm:ml-0">Sign in</a>
          )
        }
      </nav>
    </header>
    )}

    <main
      class:list={[
        'mx-auto w-full flex-1',
        embed ? 'max-w-3xl px-4 py-6' : wide ? 'max-w-5xl px-5 py-7' : 'max-w-3xl px-5 py-10 sm:py-14',
      ]}
    >
      <slot />
    </main>

    {!embed && (
    <footer class="border-t border-line">
      <div class="mx-auto max-w-3xl px-5 py-5 text-xs text-ink-soft">
        {brand} · tennis coaching, {new Date().getFullYear()}
      </div>
    </footer>
    )}

    <script is:inline>
      (function () {
        // Instant feedback: flag the page as loading on any real navigation or
        // form submit, and mark the pressed submit button busy. CSS does the rest.
        var root = document.documentElement;
        var go = function () { root.setAttribute('data-loading', ''); };
        var stop = function () { root.removeAttribute('data-loading'); };

        addEventListener(
          'click',
          function (e) {
            if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            var a = e.target.closest && e.target.closest('a[href]');
            if (!a || a.target === '_blank' || a.hasAttribute('download')) return;
            var u = new URL(a.href, location.href);
            if (u.origin !== location.origin) return;
            if (u.href.split('#')[0] === location.href.split('#')[0]) return; // same-page hash
            go();
          },
          true,
        );

        addEventListener(
          'submit',
          function (e) {
            if (e.defaultPrevented) return;
            go();
            var btn = e.submitter;
            if (btn && btn.tagName === 'BUTTON' && !btn.disabled) {
              btn.setAttribute('aria-busy', 'true');
              setTimeout(function () { btn.disabled = true; }, 0); // after the value is submitted
            }
          },
          true,
        );

        // Coming back via bfcache — clear any stale loading state, and re-enable
        // buttons the submit handler disabled before the page was frozen.
        addEventListener('pageshow', function () {
          stop();
          document.querySelectorAll('[aria-busy]').forEach(function (b) {
            b.disabled = false;
            b.removeAttribute('aria-busy');
          });
        });
        addEventListener('pagehide', stop);
      })();
    </script>

    {embed && (
      <script is:inline>
        (function () {
          // The layout is min-height:100% — inside a fixed iframe that would
          // never let scrollHeight shrink. Let content set the height instead.
          document.documentElement.style.height = 'auto';
          document.body.style.minHeight = '0';
          var post = function () {
            parent.postMessage({ type: 'technicourt:height', height: document.body.scrollHeight }, '*');
          };
          new ResizeObserver(post).observe(document.body);
          addEventListener('load', post);
        })();
      </script>
    )}
  </body>
</html>
