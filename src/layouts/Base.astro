---
import '../styles/global.css';
import { BRAND } from '../lib/config';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const { user, profile } = Astro.locals;
const isStaff = profile?.role === 'coach' || profile?.role === 'admin';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${BRAND}` : BRAND}</title>
  </head>
  <body class="min-h-full bg-neutral-50 text-neutral-900">
    <header class="border-b border-neutral-200 bg-white">
      <nav class="mx-auto flex max-w-3xl items-center gap-4 px-4 py-3 text-sm">
        <a href="/" class="font-semibold">{BRAND}</a>
        <a href="/" class="text-neutral-600 hover:text-neutral-900">Book</a>
        {user && <a href="/bookings" class="text-neutral-600 hover:text-neutral-900">My bookings</a>}
        {isStaff && <a href="/coach" class="text-neutral-600 hover:text-neutral-900">Coach</a>}
        <span class="flex-1"></span>
        {
          user ? (
            <form method="POST" action="/logout">
              <button class="text-neutral-600 hover:text-neutral-900">Sign out</button>
            </form>
          ) : (
            <a href="/login" class="text-neutral-600 hover:text-neutral-900">Sign in</a>
          )
        }
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
