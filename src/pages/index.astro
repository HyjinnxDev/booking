---
import Base from '../layouts/Base.astro';
import { listOfferings } from '../lib/offerings';
import { fmtPrice } from '../lib/format';

const { url } = Astro;
const errorCode = url.searchParams.get('error');
const offerings = await listOfferings();
const multiLoc = new Set(offerings.map((o) => o.locationId)).size > 1;

const errors: Record<string, string> = {
  slot_taken: 'That time was just taken. Pick another.',
  full: 'That class is full. Try another session.',
  unknown: 'Something went wrong. Try again.',
};

const priceHint = (o: (typeof offerings)[number]) => {
  const money = o.coaches.some((c) => c.variants.some((v) => v.price_cents !== o.priceFromCents))
    ? `from ${fmtPrice(o.priceFromCents)}`
    : fmtPrice(o.priceFromCents);
  return o.kind === 'class'
    ? `${o.classCount} upcoming · ${money}`
    : `${money} · ${o.durations.join('/')} min`;
};

const href = (o: (typeof offerings)[number]) =>
  o.coaches.length > 1 ? `/g/${o.slug}` : `/s/${o.coaches[0].typeId}`;
---

<Base title="Book a session">
  <h1 class="text-3xl font-extrabold sm:text-4xl">Book a session</h1>

  {
    errorCode && (
      <p class="mt-5 border-l-2 border-red-500 bg-white px-4 py-3 text-sm">{errors[errorCode] ?? errors.unknown}</p>
    )
  }

  {
    offerings.length === 0 ? (
      <p class="mt-8 text-ink-soft">Nothing is open for booking yet.</p>
    ) : (
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {offerings.map((o) => (
          <li>
            <a
              href={href(o)}
              class="flex h-full flex-col rounded-xl border border-line bg-white p-4 transition-colors hover:border-ink"
            >
              <span class="flex items-baseline justify-between gap-2">
                <span class="font-display text-lg font-bold">{o.name}</span>
                <span class="shrink-0 rounded-md bg-ink/5 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-ink-soft">
                  {o.kind === 'class' ? 'Group' : '1:1'}
                </span>
              </span>
              {o.blurb && <span class="mt-1 text-sm text-ink-soft">{o.blurb}</span>}
              <span class="mt-1 text-xs text-ink-soft">
                {o.coaches.length > 1 ? `${o.coaches.length} coaches` : o.coaches[0].name}
                {multiLoc && o.location ? ` · ${o.location.name}` : ''}
              </span>
              <span class="mt-3 text-sm font-semibold">{priceHint(o)}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
