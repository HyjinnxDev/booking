---
import Base from '../layouts/Base.astro';
import { getPrimaryCoach } from '../lib/coach';
import { listSessionTypes, upcomingOccurrences } from '../lib/sessions';
import { fmtPrice } from '../lib/format';

const { url } = Astro;
const errorCode = url.searchParams.get('error');

const coach = await getPrimaryCoach();
const types = coach ? await listSessionTypes(coach.id, { activeOnly: true }) : [];
const occ = coach ? await upcomingOccurrences({ coachId: coach.id }) : [];
const classCount = new Map<string, number>();
for (const o of occ) classCount.set(o.type.id, (classCount.get(o.type.id) ?? 0) + 1);

const bookable = types.filter((t) => t.variants.length > 0 && (t.kind === 'appointment' || (classCount.get(t.id) ?? 0) > 0));

const errors: Record<string, string> = {
  slot_taken: 'That slot was just taken. Pick another.',
  full: 'That class is full. Try another session.',
  unknown: 'Something went wrong. Try again.',
};

function priceHint(t: (typeof types)[number]): string {
  const prices = t.variants.map((v) => v.price_cents);
  const min = Math.min(...prices);
  const lengths = [...new Set(t.variants.map((v) => v.duration_min))].sort((a, b) => a - b);
  const money = prices.every((p) => p === min) ? fmtPrice(min) : `from ${fmtPrice(min)}`;
  return `${money} · ${lengths.join('/')} min`;
}
---

<Base title="Book a session">
  <h1 class="text-3xl font-extrabold sm:text-4xl">
    Book a session{coach && <> with <span class="mark">{coach.name}</span></>}
  </h1>

  {
    errorCode && (
      <p class="mt-5 border-l-2 border-red-500 bg-white px-4 py-3 text-sm">{errors[errorCode] ?? errors.unknown}</p>
    )
  }

  {
    !coach || bookable.length === 0 ? (
      <p class="mt-8 text-ink-soft">Nothing is open for booking yet.</p>
    ) : (
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {bookable.map((t) => (
          <li>
            <a
              href={`/s/${t.id}`}
              class="flex h-full flex-col rounded-xl border border-line bg-white p-4 transition-colors hover:border-ink"
            >
              <span class="flex items-baseline justify-between gap-2">
                <span class="font-display text-lg font-bold">{t.name}</span>
                <span class="shrink-0 rounded-md bg-ink/5 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-ink-soft">
                  {t.kind === 'class' ? 'Group' : '1:1'}
                </span>
              </span>
              {t.blurb && <span class="mt-1 text-sm text-ink-soft">{t.blurb}</span>}
              <span class="mt-3 text-sm font-semibold">
                {t.kind === 'class'
                  ? `${classCount.get(t.id)} upcoming · ${fmtPrice(t.variants[0].price_cents)}`
                  : priceHint(t)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
