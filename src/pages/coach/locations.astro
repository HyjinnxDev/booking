---
import Base from '../../layouts/Base.astro';
import { listLocations } from '../../lib/locations';

const { url } = Astro;
const locations = await listLocations();
const err = url.searchParams.get('error');

const inputCls = 'rounded-lg border border-line bg-white px-2 py-1.5 text-sm focus:border-ink focus:outline-none';
const btn = 'rounded-lg bg-ink px-3 py-1.5 text-sm font-semibold text-paper hover:opacity-90';
const ghost = 'rounded-lg border border-line px-3 py-1.5 text-sm hover:border-ink';
---

<Base title="Locations">
  <a href="/coach" class="text-sm text-ink-soft hover:text-ink">← Dashboard</a>
  <h1 class="mt-3 text-3xl font-extrabold sm:text-4xl">Locations</h1>
  <p class="mt-2 text-sm text-ink-soft">
    Venues where sessions run. Assign a session to a location on the
    <a href="/coach/services" class="underline underline-offset-2">Sessions</a> page.
    Slot times still use the business timezone — per-location timezones aren't live yet.
  </p>

  {err && <p class="mt-5 border-l-2 border-red-500 bg-white px-4 py-3 text-sm">{err}</p>}

  <div class="mt-8 space-y-3">
    {
      locations.map((l) => (
        <form method="POST" action="/api/locations" class="flex flex-wrap items-center gap-2 rounded-xl border border-line bg-white p-3 text-sm">
          <input type="hidden" name="action" value="location.update" />
          <input type="hidden" name="id" value={l.id} />
          <input name="name" value={l.name} class={`${inputCls} w-40 font-semibold`} />
          <input name="address" value={l.address ?? ''} placeholder="Address" class={`${inputCls} grow`} />
          <input name="timezone" value={l.timezone} class={`${inputCls} w-44`} />
          <label class="flex items-center gap-1.5 text-ink-soft">
            <input type="checkbox" name="active" checked={l.active} /> active
          </label>
          <button class={ghost}>Save</button>
          <button
            formaction="/api/locations"
            name="action"
            value="location.delete"
            class="text-ink-soft hover:text-ink"
            aria-label="Delete location"
            onclick="return confirm('Delete this location?')"
          >
            ×
          </button>
        </form>
      ))
    }
    {locations.length === 0 && (
      <p class="border border-dashed border-line bg-white px-4 py-6 text-center text-sm text-ink-soft">No locations yet.</p>
    )}
  </div>

  <h2 class="mt-12 text-xl font-bold">New location</h2>
  <form method="POST" action="/api/locations" class="mt-3 flex flex-wrap items-end gap-2">
    <input type="hidden" name="action" value="location.create" />
    <label class="text-sm">
      <span class="block text-ink-soft">Name</span>
      <input name="name" required placeholder="North courts" class={`${inputCls} mt-1`} />
    </label>
    <label class="grow text-sm">
      <span class="block text-ink-soft">Address — optional</span>
      <input name="address" class={`${inputCls} mt-1 w-full`} />
    </label>
    <label class="text-sm">
      <span class="block text-ink-soft">Timezone</span>
      <input name="timezone" value="Australia/Adelaide" class={`${inputCls} mt-1`} />
    </label>
    <button class={btn}>Create</button>
  </form>
</Base>
