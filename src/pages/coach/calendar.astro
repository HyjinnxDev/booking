---
import Base from '../../layouts/Base.astro';
import { createSupabaseAdmin } from '../../lib/supabase';
import { listSessionTypes, upcomingOccurrences } from '../../lib/sessions';
import { getAvailableSlots } from '../../lib/slots';
import { fmtTime, todayStr, addDaysStr, calFmt, localDay } from '../../lib/format';
import { fromZonedTime } from 'date-fns-tz';
import { BUSINESS_TZ } from '../../lib/config';

const { locals, url } = Astro;
const coachId = locals.user!.id;
const db = createSupabaseAdmin();

const span = url.searchParams.get('span') === 'week' ? 'week' : 'day';
let d = url.searchParams.get('d') || todayStr();
if (!/^\d{4}-\d{2}-\d{2}$/.test(d)) d = todayStr();

// Range: a single local day, or the ISO week (Mon–Sun) containing it.
let from = d;
if (span === 'week') {
  const wd = new Date(`${d}T12:00:00Z`).getUTCDay(); // 0=Sun
  from = addDaysStr(d, wd === 0 ? -6 : 1 - wd);
}
const days = span === 'week' ? 7 : 1;
const to = addDaysStr(from, days);
const rangeStart = fromZonedTime(`${from}T00:00:00`, BUSINESS_TZ).toISOString();
const rangeEnd = fromZonedTime(`${to}T00:00:00`, BUSINESS_TZ).toISOString();

const [types, occ, { data: apptRows }, { data: blackouts }] = await Promise.all([
  listSessionTypes(coachId),
  upcomingOccurrences({ coachId, from: new Date(rangeStart) }),
  db
    .from('bookings')
    .select('id, start_at, status, client:client_id ( name ), variant:session_variant_id ( name, session_types ( name ) )')
    .eq('coach_id', coachId)
    .is('class_occurrence_id', null)
    .neq('status', 'cancelled')
    .gte('start_at', rangeStart)
    .lt('start_at', rangeEnd)
    .order('start_at'),
  db.from('blackout_dates').select('date, reason').eq('coach_id', coachId).gte('date', from).lt('date', to),
]);

type Item = { at: string; kind: 'appt' | 'class' | 'blackout'; label: string; href?: string; sub?: string; day?: string };
const items: Item[] = [];
for (const b of (apptRows ?? []) as any[]) {
  items.push({
    at: b.start_at,
    kind: 'appt',
    label: `${b.client?.name || 'Client'} — ${b.variant?.session_types?.name ?? 'Session'}`,
    sub: b.status === 'no_show' ? 'no-show' : b.variant?.name,
    href: `/m/${b.id}`,
  });
}
for (const o of occ) {
  if (o.start_at >= rangeEnd) continue;
  items.push({
    at: o.start_at,
    kind: 'class',
    label: o.type.name,
    sub: `${o.seats_taken}/${o.capacity} booked${o.waiting > 0 ? ` · ${o.waiting} waiting` : ''}`,
    href: '/coach/schedule',
  });
}
for (const bl of (blackouts ?? []) as any[]) {
  items.push({ at: `${bl.date}T00:00:00`, kind: 'blackout', label: `Blackout${bl.reason ? ` — ${bl.reason}` : ''}`, day: bl.date });
}
items.sort((a, b) => a.at.localeCompare(b.at));

const byDay = new Map<string, Item[]>();
for (let i = 0; i < days; i++) byDay.set(addDaysStr(from, i), []);
for (const it of items) {
  const key = it.day ?? localDay(it.at);
  if (byDay.has(key)) byDay.get(key)!.push(it);
}

// ---- walk-in booking ----
const wt = url.searchParams.get('wt') ?? '';
const wv = url.searchParams.get('wv') ?? '';
const wd = url.searchParams.get('wd') || d;
const walkType = types.find((t) => t.id === wt && t.kind === 'appointment');
const walkVariant = walkType?.variants.find((v) => v.id === wv) ?? walkType?.variants[0];
const walkSlots = walkVariant ? await getAvailableSlots(coachId, wd, walkVariant.duration_min) : [];
const walkFlash = url.searchParams.get('walkin');

const prevD = addDaysStr(from, -days);
const nextD = addDaysStr(from, days);
const q = (o: Record<string, string>) => new URLSearchParams({ span, d, ...o }).toString();
---

<Base title="Calendar">
  <a href="/coach" class="text-sm text-ink-soft hover:text-ink">← Dashboard</a>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-3xl font-extrabold sm:text-4xl">Calendar</h1>
    <div class="flex items-center gap-2 text-sm">
      <a href={`/coach/calendar?${new URLSearchParams({ span, d: prevD }).toString()}`} class="rounded-lg border border-line px-2 py-1 hover:border-ink">←</a>
      <a href={`/coach/calendar?${new URLSearchParams({ span, d: todayStr() }).toString()}`} class="rounded-lg border border-line px-2 py-1 hover:border-ink">Today</a>
      <a href={`/coach/calendar?${new URLSearchParams({ span, d: nextD }).toString()}`} class="rounded-lg border border-line px-2 py-1 hover:border-ink">→</a>
      <a
        href={`/coach/calendar?${new URLSearchParams({ span: span === 'day' ? 'week' : 'day', d }).toString()}`}
        class="rounded-lg border border-line px-2 py-1 hover:border-ink"
      >
        {span === 'day' ? 'Week' : 'Day'}
      </a>
    </div>
  </div>

  {walkFlash === 'ok' && <p class="mt-4 border-l-2 border-ball bg-white px-4 py-3 text-sm">Walk-in booked — confirmation sent.</p>}
  {walkFlash === 'fail' && <p class="mt-4 border-l-2 border-red-500 bg-white px-4 py-3 text-sm">That time wasn't open. Pick another.</p>}

  <div class="mt-6 space-y-6">
    {
      [...byDay.entries()].map(([day, list]) => (
        <div>
          <p class="font-display text-sm font-semibold uppercase tracking-wider text-ink-soft">
            {calFmt(day, 'EEEE d MMMM')}
          </p>
          {list.length === 0 ? (
            <p class="mt-2 text-sm text-ink-soft">Nothing scheduled.</p>
          ) : (
            <ul class="mt-2 divide-y divide-line overflow-hidden rounded-xl border border-line bg-white">
              {list.map((it) => (
                <li class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
                  <span>
                    <span class="tnum font-semibold">
                      {it.kind === 'blackout' ? 'All day' : fmtTime(it.at)}
                    </span>
                    <span class="ml-2">{it.label}</span>
                    {it.sub && <span class="text-ink-soft"> · {it.sub}</span>}
                  </span>
                  {it.href && (
                    <a href={it.href} class="shrink-0 text-xs text-ink-soft underline underline-offset-2 hover:text-ink">
                      open
                    </a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>

  <h2 class="mt-12 text-xl font-bold">Add a walk-in</h2>
  <p class="mt-1 text-sm text-ink-soft">Books an appointment for a client and emails them the confirmation.</p>
  <form method="GET" class="mt-3 flex flex-wrap items-end gap-2 text-sm">
    <input type="hidden" name="span" value={span} />
    <input type="hidden" name="d" value={d} />
    <label>
      <span class="block text-ink-soft">Session</span>
      <select name="wt" class="mt-1 rounded-lg border border-line bg-white px-2 py-1.5">
        {types.filter((t) => t.kind === 'appointment').map((t) => (
          <option value={t.id} selected={t.id === wt}>{t.name}</option>
        ))}
      </select>
    </label>
    {walkType && walkType.variants.length > 1 && (
      <label>
        <span class="block text-ink-soft">Option</span>
        <select name="wv" class="mt-1 rounded-lg border border-line bg-white px-2 py-1.5">
          {walkType.variants.map((v) => (
            <option value={v.id} selected={v.id === walkVariant?.id}>{v.name}</option>
          ))}
        </select>
      </label>
    )}
    <label>
      <span class="block text-ink-soft">Date</span>
      <input type="date" name="wd" value={wd} min={todayStr()} class="mt-1 rounded-lg border border-line bg-white px-2 py-1.5" />
    </label>
    <button class="rounded-lg border border-line px-3 py-1.5 hover:border-ink">Show times</button>
  </form>

  {
    walkVariant && (
      <form method="POST" action="/api/walkin" class="mt-4 rounded-xl border border-line bg-white p-4">
        <input type="hidden" name="variant_id" value={walkVariant.id} />
        <input type="hidden" name="date" value={wd} />
        <input type="hidden" name="back" value={`/coach/calendar?${q({})}`} />
        <div class="flex flex-wrap gap-3">
          <label class="text-sm">
            <span class="block text-ink-soft">Client name</span>
            <input name="name" required class="mt-1 rounded-lg border border-line bg-white px-2 py-1.5 text-sm" />
          </label>
          <label class="text-sm">
            <span class="block text-ink-soft">Client email</span>
            <input name="email" type="email" required class="mt-1 rounded-lg border border-line bg-white px-2 py-1.5 text-sm" />
          </label>
        </div>
        {walkSlots.length === 0 ? (
          <p class="mt-3 text-sm text-ink-soft">No open times on {calFmt(wd, 'EEEE d MMMM')}.</p>
        ) : (
          <div class="mt-3 flex flex-wrap gap-2">
            {walkSlots.map((s) => (
              <button
                name="start_at"
                value={s.startAt}
                class="rounded-lg border border-ink px-3 py-1.5 text-sm font-semibold hover:bg-ink hover:text-paper"
              >
                {fmtTime(s.startAt)}
              </button>
            ))}
          </div>
        )}
      </form>
    )
  }
</Base>
