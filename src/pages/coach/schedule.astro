---
import Coach from '../../layouts/Coach.astro';
import { listSessionTypes, upcomingOccurrences } from '../../lib/sessions';
import { fmtLong, todayStr, addDaysStr } from '../../lib/format';
import { getSettings } from '../../lib/settings';
import { getStaffScope } from '../../lib/staff';

const { url } = Astro;
const scope = await getStaffScope(Astro);
if (scope.needsPick) return Astro.redirect('/admin/staff');
const coachId = scope.coachId!;
const api = scope.isSelf ? '/api/schedule' : `/api/schedule?coach=${coachId}`;

const [types, occ] = await Promise.all([listSessionTypes(coachId), upcomingOccurrences({ coachId })]);
const classTypes = types.filter((t) => t.kind === 'class');

const err = url.searchParams.get('error');
const added = url.searchParams.get('added');
const today = todayStr();
const defaultUntil = addDaysStr(today, (await getSettings()).seriesWeeks * 7);
---

<Coach
  title="Classes"
  desc="Put dates on the calendar for your group sessions. Manage class types and prices on the Sessions tab."
  editingCoach={scope.isSelf ? undefined : scope.coachName}
>
  {err && <p class="mb-4 border-l-2 border-red-500 bg-white px-4 py-2.5 text-sm">{err}</p>}
  {added && <p class="mb-4 border-l-2 border-ball bg-white px-4 py-2.5 text-sm">Added {added} session{added === '1' ? '' : 's'}.</p>}

  {
    classTypes.length === 0 ? (
      <p class="text-sm text-ink-soft">
        No class-type sessions yet. Add one on the{' '}
        <a href="/coach/services" class="font-semibold text-ink underline underline-offset-2">Sessions</a> tab first.
      </p>
    ) : (
      <form method="POST" action={api} class="card flex flex-wrap items-end gap-2.5 p-4">
        <input type="hidden" name="action" value="occ.create" />
        <label class="text-sm">
          <span class="mb-1 block text-ink-soft">Class</span>
          <select name="session_type_id" class="field w-48">
            {classTypes.map((t) => {
              const v = t.variants.find((x) => x.active) ?? t.variants[0];
              return <option value={t.id}>{t.name}{v ? ` — ${v.duration_min} min` : ''}</option>;
            })}
          </select>
        </label>
        <label class="text-sm">
          <span class="mb-1 block text-ink-soft">Date</span>
          <input type="date" name="date" required min={today} value={today} class="field w-40" />
        </label>
        <label class="text-sm">
          <span class="mb-1 block text-ink-soft">Start</span>
          <input type="time" name="time" required value="18:00" class="field w-28" />
        </label>
        <label class="text-sm">
          <span class="mb-1 block text-ink-soft">Seats</span>
          <input type="number" name="capacity" required value="8" min="1" class="field w-16" />
        </label>
        <label class="flex items-center gap-1.5 py-2 text-sm text-ink-soft">
          <input type="checkbox" name="repeat" /> Weekly until
        </label>
        <input type="date" name="until" min={today} max={defaultUntil} value={defaultUntil} class="field w-40" />
        <button class="btn">Schedule</button>
      </form>
    )
  }

  <p class="eyebrow mt-8">Upcoming classes</p>
  {
    occ.length === 0 ? (
      <p class="mt-2 text-sm text-ink-soft">Nothing scheduled.</p>
    ) : (
      <div class="card rowlist mt-2">
        {occ.map((o) => (
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 px-4 py-2.5 text-sm">
            <div class="min-w-0">
              <p class="tnum font-semibold">{fmtLong(o.start_at)}</p>
              <p class="text-ink-soft">
                {o.type.name} · {o.seats_taken}/{o.capacity} booked
                {o.waiting > 0 && ` · ${o.waiting} waiting`}
                {o.series_id && ' · weekly series'}
              </p>
            </div>
            <div class="flex items-center gap-1.5">
              <form method="POST" action={api} onsubmit="return confirm('Cancel this class? Everyone booked is emailed.')">
                <input type="hidden" name="action" value="occ.cancel" />
                <input type="hidden" name="id" value={o.id} />
                <button class="btn btn-ghost btn-sm btn-danger">Cancel</button>
              </form>
              {o.series_id && (
                <form method="POST" action={api} onsubmit="return confirm('Cancel every future session in this series?')">
                  <input type="hidden" name="action" value="series.cancel" />
                  <input type="hidden" name="series_id" value={o.series_id} />
                  <button class="btn btn-quiet btn-sm">Cancel series</button>
                </form>
              )}
            </div>
          </div>
        ))}
      </div>
    )
  }
</Coach>
