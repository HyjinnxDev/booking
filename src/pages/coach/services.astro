---
import Coach from '../../layouts/Coach.astro';
import { listSessionTypes } from '../../lib/sessions';
import { listLocations } from '../../lib/locations';
import { parseIntakeFields } from '../../lib/intake';
import { fmtPrice } from '../../lib/format';
import { getStaffScope, coachLocationIds } from '../../lib/staff';

const { url } = Astro;
const scope = await getStaffScope(Astro);
if (scope.needsPick) return Astro.redirect('/admin/staff');
const coachId = scope.coachId!;
const api = scope.isSelf ? '/api/services' : `/api/services?coach=${coachId}`;

const [types, allLocations, myLocIds] = await Promise.all([
  listSessionTypes(coachId),
  listLocations({ activeOnly: true }),
  coachLocationIds(coachId),
]);
// A coach picks from their assigned locations; if none are assigned, all are open.
const locations = myLocIds.length ? allLocations.filter((l) => myLocIds.includes(l.id)) : allLocations;
const multiLoc = locations.length > 1;
const err = url.searchParams.get('error');

const priceSummary = (t: (typeof types)[number]) => {
  if (t.variants.length === 0) return 'no options yet';
  const prices = t.variants.map((v) => v.price_cents);
  const lo = Math.min(...prices);
  const lens = [...new Set(t.variants.map((v) => v.duration_min))].sort((a, b) => a - b).join('/');
  return `${prices.every((p) => p === lo) ? fmtPrice(lo) : `from ${fmtPrice(lo)}`} · ${lens} min`;
};
---

<Coach
  title="Sessions"
  desc="Appointments let clients pick any open time. Classes are dated group sessions — add their dates on the Classes tab."
  editingCoach={scope.isSelf ? undefined : scope.coachName}
>
  {err && <p class="mb-4 border-l-2 border-red-500 bg-white px-4 py-2.5 text-sm" role="alert">{err}</p>}

  <div class="space-y-2">
    {
      types.map((t) => {
        const questions = parseIntakeFields(t.intake_fields);
        return (
          <details class="card group">
            <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 text-sm hover:bg-paper">
              <span class="rounded bg-ink/5 px-1.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-ink-soft">
                {t.kind === 'class' ? 'Class' : '1:1'}
              </span>
              <span class="font-semibold">{t.name}</span>
              <span class="truncate text-ink-soft">· {priceSummary(t)}</span>
              {questions.length > 0 && <span class="text-ink-soft">· {questions.length} question{questions.length === 1 ? '' : 's'}</span>}
              {!t.active && <span class="text-ink-soft">· hidden</span>}
              <span class="ml-auto text-ink-soft transition group-open:rotate-90">›</span>
            </summary>

            <div class="space-y-4 border-t border-line bg-paper p-4">
              <form method="POST" action={api} class="flex flex-wrap items-end gap-2">
                <input type="hidden" name="action" value="type.update" />
                <input type="hidden" name="id" value={t.id} />
                <label class="text-sm">
                  <span class="mb-1 block text-ink-soft">Name</span>
                  <input name="name" value={t.name} class="field w-48" />
                </label>
                <label class="grow text-sm">
                  <span class="mb-1 block text-ink-soft">Description</span>
                  <input name="blurb" value={t.blurb ?? ''} placeholder="Shown to clients" class="field" />
                </label>
                {multiLoc && (
                  <label class="text-sm">
                    <span class="mb-1 block text-ink-soft">Location</span>
                    <select name="location_id" class="field w-40">
                      {locations.map((l) => (
                        <option value={l.id} selected={l.id === t.location_id}>{l.name}</option>
                      ))}
                    </select>
                  </label>
                )}
                <label class="text-sm">
                  <span class="mb-1 block text-ink-soft">Cancel cutoff</span>
                  <span class="flex items-center gap-1">
                    <input type="number" name="cancel_cutoff_hours" value={t.cancel_cutoff_hours} min="0" max="720" class="field w-16" />
                    <span class="text-ink-soft">h</span>
                  </span>
                </label>
                <label class="flex items-center gap-1.5 py-2 text-sm text-ink-soft">
                  <input type="checkbox" name="active" checked={t.active} /> Visible to clients
                </label>
                <button class="btn">Save</button>
              </form>

              <div>
                <p class="eyebrow">Options</p>
                <div class="mt-1.5 space-y-1.5">
                  {t.variants.map((v) => (
                    <form method="POST" action={api} class="flex flex-wrap items-center gap-1.5 text-sm">
                      <input type="hidden" name="action" value="variant.update" />
                      <input type="hidden" name="id" value={v.id} />
                      <input name="name" value={v.name} class="field w-28" />
                      <span class="flex items-center gap-1">
                        <input type="number" name="duration_min" value={v.duration_min} min="5" max="480" step="5" class="field w-16" />
                        <span class="text-ink-soft">min</span>
                      </span>
                      <span class="flex items-center gap-1">
                        <span class="text-ink-soft">$</span>
                        <input type="number" name="price" value={(v.price_cents / 100).toString()} min="0" step="0.01" class="field w-20" />
                      </span>
                      {t.kind === 'class' && (
                        <span class="flex items-center gap-1">
                          <input type="number" name="capacity" value={v.capacity} min="1" class="field w-14" />
                          <span class="text-ink-soft">seats</span>
                        </span>
                      )}
                      {t.kind === 'appointment' && <input type="hidden" name="capacity" value="1" />}
                      <button class="btn btn-ghost btn-sm">Save</button>
                      <button formaction={api} name="action" value="variant.delete" class="btn btn-quiet btn-sm" aria-label="Remove option">×</button>
                    </form>
                  ))}
                  {t.variants.length === 0 && <p class="text-sm text-ink-soft">None yet.</p>}
                </div>
                {t.kind === 'appointment' && (
                  <form method="POST" action={api} class="mt-2 flex flex-wrap items-center gap-1.5 text-sm">
                    <input type="hidden" name="action" value="variant.add" />
                    <input type="hidden" name="session_type_id" value={t.id} />
                    <input type="hidden" name="capacity" value="1" />
                    <input name="name" required placeholder="Name" class="field w-28" />
                    <span class="flex items-center gap-1">
                      <input type="number" name="duration_min" required value="30" min="5" max="480" step="5" class="field w-16" />
                      <span class="text-ink-soft">min</span>
                    </span>
                    <span class="flex items-center gap-1">
                      <span class="text-ink-soft">$</span>
                      <input type="number" name="price" value="0" min="0" step="0.01" class="field w-20" />
                    </span>
                    <button class="btn btn-ghost btn-sm">Add option</button>
                  </form>
                )}
              </div>

              <div>
                <p class="eyebrow">Booking questions</p>
                <div class="mt-1.5 space-y-1">
                  {questions.map((f, i) => (
                    <div class="flex items-center gap-2 text-sm">
                      <span>{f.label}</span>
                      <span class="text-xs text-ink-soft">{f.type}{f.required ? ' · required' : ''}</span>
                      <form method="POST" action={api}>
                        <input type="hidden" name="action" value="intake.remove" />
                        <input type="hidden" name="id" value={t.id} />
                        <input type="hidden" name="index" value={i} />
                        <button class="btn btn-quiet btn-sm" aria-label="Remove question">×</button>
                      </form>
                    </div>
                  ))}
                  {questions.length === 0 && <p class="text-sm text-ink-soft">None.</p>}
                </div>
                <form method="POST" action={api} class="mt-2 flex flex-wrap items-center gap-1.5 text-sm">
                  <input type="hidden" name="action" value="intake.add" />
                  <input type="hidden" name="id" value={t.id} />
                  <input name="label" required placeholder="e.g. Any injuries?" class="field grow" />
                  <select name="kind" class="field w-36">
                    <option value="text">Short text</option>
                    <option value="textarea">Long text</option>
                    <option value="checkbox">Checkbox / waiver</option>
                  </select>
                  <label class="flex items-center gap-1 text-ink-soft">
                    <input type="checkbox" name="required" /> Required
                  </label>
                  <button class="btn btn-ghost btn-sm">Add question</button>
                </form>
              </div>

              <form method="POST" action={api} onsubmit="return confirm('Delete this session type?')">
                <input type="hidden" name="action" value="type.delete" />
                <input type="hidden" name="id" value={t.id} />
                <button class="btn btn-quiet btn-sm btn-danger">Delete session type</button>
              </form>
            </div>
          </details>
        );
      })
    }
    {types.length === 0 && <p class="text-sm text-ink-soft">No session types yet. Add one below.</p>}
  </div>

  <details class="mt-6">
    <summary class="eyebrow cursor-pointer">Add a session type</summary>
    <form method="POST" action={api} class="mt-3 flex flex-wrap items-end gap-2">
      <input type="hidden" name="action" value="type.create" />
      <label class="text-sm">
        <span class="mb-1 block text-ink-soft">Name</span>
        <input name="name" required placeholder="Private lesson" class="field w-48" />
      </label>
      <label class="text-sm">
        <span class="mb-1 block text-ink-soft">Type</span>
        <select name="kind" class="field w-40">
          <option value="appointment">1:1 appointment</option>
          <option value="class">Group class</option>
        </select>
      </label>
      <label class="grow text-sm">
        <span class="mb-1 block text-ink-soft">Description</span>
        <input name="blurb" class="field" />
      </label>
      {multiLoc && (
        <label class="text-sm">
          <span class="mb-1 block text-ink-soft">Location</span>
          <select name="location_id" class="field w-40">
            {locations.map((l) => <option value={l.id}>{l.name}</option>)}
          </select>
        </label>
      )}
      <button class="btn">Create</button>
    </form>
    <p class="mt-2 text-xs text-ink-soft">A class starts with one editable option (60 min, 8 seats, free).</p>
  </details>
</Coach>
