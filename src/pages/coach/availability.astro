---
import Coach from '../../layouts/Coach.astro';
import { SLOT_STEP_MIN } from '../../lib/config';

const { locals, url } = Astro;
const coachId = locals.user!.id;
const todayIso = new Date().toISOString().slice(0, 10);

const [{ data: rules }, { data: blackouts }] = await Promise.all([
  locals.supabase
    .from('availability')
    .select('id, weekday, start_time, end_time')
    .eq('coach_id', coachId)
    .order('weekday')
    .order('start_time'),
  locals.supabase
    .from('blackout_dates')
    .select('id, date, reason')
    .eq('coach_id', coachId)
    .gte('date', todayIso)
    .order('date'),
]);

const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const err = url.searchParams.get('error');
const byDay = (wd: number) => (rules ?? []).filter((r) => r.weekday === wd);
const hhmm = (t: string) => t.slice(0, 5);
---

<Coach
  title="Hours"
  desc={`Business timezone. Appointment start times step every ${SLOT_STEP_MIN} minutes inside these windows; each session's length is set on the Sessions tab.`}
>
  {err && <p class="mb-4 border-l-2 border-red-500 bg-white px-4 py-2.5 text-sm">{err}</p>}

  <div class="card rowlist">
    {
      DAYS.map((label, wd) => (
        <div class="flex flex-wrap items-center gap-2 px-4 py-2.5 text-sm">
          <span class="w-24 shrink-0 font-semibold">{label}</span>
          {byDay(wd).map((r) => (
            <span class="tnum inline-flex items-center gap-1.5 rounded-md bg-paper px-2 py-1 ring-1 ring-line">
              {hhmm(r.start_time)}–{hhmm(r.end_time)}
              <form method="POST" action="/api/availability">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={r.id} />
                <button class="btn btn-quiet btn-sm" aria-label="Remove window">×</button>
              </form>
            </span>
          ))}
          {byDay(wd).length === 0 && <span class="text-ink-soft">Closed</span>}
        </div>
      ))
    }
  </div>

  <form method="POST" action="/api/availability" class="mt-3 flex flex-wrap items-end gap-2">
    <label class="text-sm">
      <span class="mb-1 block text-ink-soft">Day</span>
      <select name="weekday" class="field w-36">
        {DAYS.map((label, wd) => <option value={wd}>{label}</option>)}
      </select>
    </label>
    <label class="text-sm">
      <span class="mb-1 block text-ink-soft">From</span>
      <input type="time" name="start_time" required value="09:00" class="field w-28" />
    </label>
    <label class="text-sm">
      <span class="mb-1 block text-ink-soft">To</span>
      <input type="time" name="end_time" required value="17:00" class="field w-28" />
    </label>
    <button class="btn btn-ghost">Add hours</button>
  </form>

  <p class="eyebrow mt-8">Blackout dates</p>
  <p class="mt-1 text-sm text-ink-soft">Whole days closed — holidays, travel.</p>

  <div class="card rowlist mt-2">
    {
      (blackouts ?? []).map((b) => (
        <div class="flex items-center justify-between gap-4 px-4 py-2 text-sm">
          <span class="tnum">
            {b.date}
            {b.reason && <span class="text-ink-soft"> — {b.reason}</span>}
          </span>
          <form method="POST" action="/api/blackouts">
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="id" value={b.id} />
            <button class="btn btn-quiet btn-sm">Remove</button>
          </form>
        </div>
      ))
    }
    {(blackouts ?? []).length === 0 && <div class="px-4 py-2 text-sm text-ink-soft">None.</div>}
  </div>

  <form method="POST" action="/api/blackouts" class="mt-3 flex flex-wrap items-center gap-2">
    <input type="date" name="date" required min={todayIso} class="field w-40" />
    <input type="text" name="reason" placeholder="Reason (optional)" maxlength="120" class="field grow" />
    <button class="btn btn-ghost">Add blackout</button>
  </form>
</Coach>
