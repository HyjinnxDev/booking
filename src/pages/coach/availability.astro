---
import Base from '../../layouts/Base.astro';

const { locals, url } = Astro;
const coachId = locals.user!.id;

const [{ data: rules }, { data: blackouts }] = await Promise.all([
  locals.supabase
    .from('availability')
    .select('id, weekday, start_time, end_time')
    .eq('coach_id', coachId)
    .order('weekday')
    .order('start_time'),
  locals.supabase
    .from('blackout_dates')
    .select('id, date, reason')
    .eq('coach_id', coachId)
    .gte('date', new Date().toISOString().slice(0, 10))
    .order('date'),
]);

const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const err = url.searchParams.get('error');
const byDay = (wd: number) => (rules ?? []).filter((r) => r.weekday === wd);
const hhmm = (t: string) => t.slice(0, 5);
---

<Base title="Availability">
  <h1 class="text-xl font-semibold">Weekly availability</h1>
  <p class="mt-1 text-sm text-neutral-600">Times are in the business timezone. Slots are 60 minutes.</p>
  {err && <p class="mt-3 rounded bg-red-50 px-3 py-2 text-sm text-red-700">{err}</p>}

  <div class="mt-4 space-y-3">
    {
      DAYS.map((label, wd) => (
        <div class="rounded border border-neutral-200 bg-white p-3">
          <p class="text-sm font-semibold">{label}</p>
          <ul class="mt-1">
            {byDay(wd).map((r) => (
              <li class="flex items-center gap-2 py-0.5 text-sm">
                <span>
                  {hhmm(r.start_time)}–{hhmm(r.end_time)}
                </span>
                <form method="POST" action="/api/availability">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={r.id} />
                  <button class="text-red-600 hover:underline">remove</button>
                </form>
              </li>
            ))}
            {byDay(wd).length === 0 && <li class="py-0.5 text-sm text-neutral-400">unavailable</li>}
          </ul>
          <form method="POST" action="/api/availability" class="mt-2 flex items-center gap-2 text-sm">
            <input type="hidden" name="weekday" value={wd} />
            <input type="time" name="start_time" required class="rounded border border-neutral-300 px-2 py-1" />
            <span>to</span>
            <input type="time" name="end_time" required class="rounded border border-neutral-300 px-2 py-1" />
            <button class="rounded border border-neutral-900 px-2 py-1">Add</button>
          </form>
        </div>
      ))
    }
  </div>

  <h2 class="mt-8 text-lg font-semibold">Blackout dates</h2>
  <p class="mt-1 text-sm text-neutral-600">Whole days with no bookings (holidays, travel).</p>

  <ul class="mt-3 divide-y divide-neutral-200 rounded border border-neutral-200 bg-white">
    {
      (blackouts ?? []).map((b) => (
        <li class="flex items-center justify-between px-4 py-2 text-sm">
          <span>
            {b.date}
            {b.reason ? ` — ${b.reason}` : ''}
          </span>
          <form method="POST" action="/api/blackouts">
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="id" value={b.id} />
            <button class="text-red-600 hover:underline">remove</button>
          </form>
        </li>
      ))
    }
    {(blackouts ?? []).length === 0 && <li class="px-4 py-2 text-sm text-neutral-400">none</li>}
  </ul>

  <form method="POST" action="/api/blackouts" class="mt-3 flex items-center gap-2 text-sm">
    <input type="date" name="date" required min={new Date().toISOString().slice(0, 10)}
      class="rounded border border-neutral-300 px-2 py-1" />
    <input type="text" name="reason" placeholder="reason (optional)" maxlength="120"
      class="rounded border border-neutral-300 px-2 py-1" />
    <button class="rounded border border-neutral-900 px-2 py-1">Add blackout</button>
  </form>
</Base>
