---
import Admin from '../../layouts/Admin.astro';
import { createSupabaseAdmin } from '../../lib/supabase';
import { fmtLong } from '../../lib/format';

// Covers admin-only write paths (staff, settings, locations, broadcasts), not
// every action in the app. Add more logAudit() call sites if this proves useful.
const db = createSupabaseAdmin();
const { data: rows } = await db
  .from('audit_log')
  .select('id, action, meta, created_at, actor:actor_id ( name, email )')
  .order('created_at', { ascending: false })
  .limit(200);
const entries = (rows ?? []) as any[];
---

<Admin title="Audit log" desc="The last 200 admin actions: staff, settings, locations, broadcasts.">
  <div class="card rowlist text-sm">
    {entries.length === 0 ? (
      <p class="px-4 py-3 text-ink-soft">Nothing logged yet.</p>
    ) : (
      entries.map((e) => (
        <div class="px-4 py-2.5">
          <span class="tnum text-ink-soft">{fmtLong(e.created_at)}</span>
          <span class="ml-2 font-semibold">{e.action}</span>
          <span class="ml-2 text-ink-soft">
            {e.actor?.name || e.actor?.email || 'system'}
            {e.meta && Object.keys(e.meta).length > 0 && ` · ${JSON.stringify(e.meta)}`}
          </span>
        </div>
      ))
    )}
  </div>
</Admin>
