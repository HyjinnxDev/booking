---
import Admin from '../../layouts/Admin.astro';
import { createSupabaseAdmin } from '../../lib/supabase';
import { fmtPrice } from '../../lib/format';

const { url } = Astro;
const db = createSupabaseAdmin();

const [{ data: typeRows }, { data: passRows }] = await Promise.all([
  db.from('session_types').select('id, name, coach:coach_id ( name )').order('name'),
  db
    .from('passes')
    .select('id, name, total, used, price_cents, status, expires_at, session_type_id, client:client_id ( name, email )')
    .order('created_at', { ascending: false }),
]);
const types = (typeRows ?? []).map((t: any) => ({ id: t.id, name: t.name, coachName: t.coach?.name ?? '' }));
const passes = (passRows ?? []) as any[];
const active = passes.filter((p) => p.status === 'active');
const voided = passes.filter((p) => p.status === 'void');
const typeName = (id: string | null) => {
  if (!id) return 'Any session';
  const t = types.find((x) => x.id === id);
  return t ? `${t.name}${t.coachName ? ` (${t.coachName})` : ''}` : 'Unknown';
};

const err = url.searchParams.get('error');
const issued = url.searchParams.get('issued');
---

<Admin
  title="Passes"
  desc="Sell a bundle of sessions in person, then issue it here. The client picks it at checkout and the balance ticks down. Cancelling a covered booking returns the credit."
>
  {err && <p class="mb-4 border-l-2 border-red-500 bg-white px-4 py-2.5 text-sm">{err}</p>}
  {issued && <p class="mb-4 border-l-2 border-ball bg-white px-4 py-2.5 text-sm">Pass issued.</p>}

  <details class="card" open={!!err || active.length === 0}>
    <summary class="eyebrow cursor-pointer px-4 py-3">Issue a pass</summary>
    <form method="POST" action="/api/passes" class="grid gap-2.5 border-t border-line bg-paper p-4 sm:grid-cols-2">
      <input type="hidden" name="action" value="pass.issue" />
      <label class="text-sm">
        <span class="mb-1 block text-ink-soft">Client name</span>
        <input name="client_name" required class="field" />
      </label>
      <label class="text-sm">
        <span class="mb-1 block text-ink-soft">Client email</span>
        <input name="client_email" type="email" required class="field" />
      </label>
      <label class="text-sm">
        <span class="mb-1 block text-ink-soft">Pass name</span>
        <input name="name" required placeholder="10-class pack" class="field" />
      </label>
      <label class="text-sm">
        <span class="mb-1 block text-ink-soft">Covers</span>
        <select name="session_type_id" class="field">
          <option value="">Any session</option>
          {types.map((t) => <option value={t.id}>{t.name}{t.coachName ? ` — ${t.coachName}` : ''}</option>)}
        </select>
      </label>
      <label class="text-sm">
        <span class="mb-1 block text-ink-soft">Sessions</span>
        <input name="total" type="number" required value="10" min="1" max="100" class="field" />
      </label>
      <label class="text-sm">
        <span class="mb-1 block text-ink-soft">Price paid — optional</span>
        <input name="price" type="number" min="0" step="0.01" placeholder="0" class="field" />
      </label>
      <label class="text-sm">
        <span class="mb-1 block text-ink-soft">Expires — optional</span>
        <input name="expires_at" type="date" class="field" />
      </label>
      <div class="flex items-end">
        <button class="btn">Issue pass</button>
      </div>
    </form>
  </details>

  <p class="eyebrow mt-8">Active ({active.length})</p>
  {
    active.length === 0 ? (
      <p class="mt-2 text-sm text-ink-soft">None yet.</p>
    ) : (
      <div class="card rowlist mt-2">
        {active.map((p) => (
          <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-sm">
            <div class="min-w-0">
              <p class="font-semibold">
                {p.client?.name || p.client?.email}
                <span class="ml-2 font-normal text-ink-soft">{p.name}</span>
              </p>
              <p class="text-xs text-ink-soft">
                {typeName(p.session_type_id)} · {p.total - p.used}/{p.total} left · {fmtPrice(p.price_cents)}
                {p.expires_at ? ` · expires ${p.expires_at}` : ''}
              </p>
            </div>
            <form method="POST" action="/api/passes" onsubmit="return confirm('Void this pass?')">
              <input type="hidden" name="action" value="pass.void" />
              <input type="hidden" name="id" value={p.id} />
              <button class="btn btn-quiet btn-sm btn-danger">Void</button>
            </form>
          </div>
        ))}
      </div>
    )
  }

  {
    voided.length > 0 && (
      <>
        <p class="eyebrow mt-8">Void ({voided.length})</p>
        <div class="card rowlist mt-2 text-ink-soft">
          {voided.map((p) => (
            <div class="px-4 py-2.5 text-sm">
              <span class="font-semibold">{p.client?.name || p.client?.email}</span>
              <span class="ml-2">{p.name}</span>
              <span class="text-xs"> · {typeName(p.session_type_id)} · {p.total - p.used}/{p.total} left</span>
            </div>
          ))}
        </div>
      </>
    )
  }
</Admin>
