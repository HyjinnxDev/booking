---
import Admin from '../../layouts/Admin.astro';
import EmbedBuilder from '../../components/EmbedBuilder.astro';
import { listCoaches } from '../../lib/staff';
import { listOfferings } from '../../lib/offerings';
import { listSessionTypes } from '../../lib/sessions';

const [coaches, offerings] = await Promise.all([listCoaches({ activeOnly: true }), listOfferings()]);
const perCoach = await Promise.all(
  coaches.map(async (c) => ({
    c,
    types: (await listSessionTypes(c.id, { activeOnly: true })).filter((t) => t.variants.length),
  })),
);

const targets = [
  { label: 'Whole booking site — every session', path: '/' },
  ...offerings.map((o) => ({
    label: o.coaches.length > 1 ? `${o.name} — all coaches` : `${o.name} — ${o.coaches[0].name}`,
    path: o.coaches.length > 1 ? `/g/${o.slug}` : `/s/${o.coaches[0].typeId}`,
  })),
  ...perCoach.flatMap(({ c, types }) => types.map((t) => ({ label: `${c.name} · ${t.name}`, path: `/s/${t.id}` }))),
];
---

<Admin
  title="Embed"
  desc="Booking widgets for the main site or any coach's own website. Pick a target, copy the snippet."
>
  <EmbedBuilder targets={targets} allowAccent />
</Admin>
