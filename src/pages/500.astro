---
import Base from '../layouts/Base.astro';
// Astro renders this for an uncaught error in an SSR page.
const error = Astro.props.error;
if (error) console.error('500:', error);
---

<Base title="Something went wrong">
  <h1 class="text-3xl font-extrabold sm:text-4xl">Something went wrong</h1>
  <p class="mt-3 text-ink-soft">
    That didn't work on our end. Nothing was charged. Try again in a moment — if a booking didn't go
    through, you'll know because there's no confirmation email.
  </p>
  <a href="/" class="mt-6 inline-block text-sm font-semibold text-ink underline underline-offset-2">
    Back to booking
  </a>
</Base>
