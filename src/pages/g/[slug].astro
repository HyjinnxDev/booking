---
import Base from '../../layouts/Base.astro';
import { getOffering } from '../../lib/offerings';
import { mergeAvailability } from '../../lib/slots';
import { fmtTime, fmtPrice, todayStr, addDaysStr, calFmt } from '../../lib/format';
import { getSettings } from '../../lib/settings';

const { params, url } = Astro;
const offering = await getOffering(params.slug!);
if (!offering) return Astro.redirect('/');
// A single-coach offering has no "any" choice to make, go straight in.
if (offering.coaches.length === 1) return Astro.redirect(`/s/${offering.coaches[0].typeId}`);

const errorCode = url.searchParams.get('error');
const today = todayStr();
const maxDate = addDaysStr(today, (await getSettings()).bookingWindowDays);

let date = url.searchParams.get('date') || today;
if (date < today) date = today;
if (date > maxDate) date = maxDate;

const dur =
  offering.durations.includes(Number(url.searchParams.get('dur'))) ? Number(url.searchParams.get('dur')) : offering.durations[0];

const pool =
  offering.kind === 'appointment' ? offering.coaches.filter((c) => c.variants.some((v) => v.duration_min === dur)) : [];
const merged = pool.length ? await mergeAvailability(pool.map((c) => c.id), date, dur) : [];

const rail = Array.from({ length: 7 }, (_, i) => {
  const d = addDaysStr(today, i);
  return { date: d, dow: calFmt(d, 'EEE'), day: calFmt(d, 'd'), isToday: d === today, isSelected: d === date };
});

const q = (extra: Record<string, string>) => new URLSearchParams({ dur: String(dur), date, ...extra }).toString();
const priceFor = (c: (typeof offering.coaches)[number]) => {
  const ps = c.variants.map((v) => v.price_cents);
  const lo = Math.min(...ps);
  return ps.every((p) => p === lo) ? fmtPrice(lo) : `from ${fmtPrice(lo)}`;
};
---

<Base title={offering.name}>
  <a href="/" class="text-sm text-ink-soft hover:text-ink">← All sessions</a>
  <h1 class="mt-3 text-3xl font-extrabold sm:text-4xl">{offering.name}</h1>
  {offering.blurb && <p class="mt-2 text-ink-soft">{offering.blurb}</p>}
  {offering.location && <p class="mt-1 text-sm text-ink-soft">📍 {offering.location.name}</p>}

  {errorCode && (
    <p class="mt-5 border-l-2 border-red-500 bg-white px-4 py-3 text-sm" role="alert">That time was just taken. Pick another.</p>
  )}

  <p class="eyebrow mt-8">Choose a coach</p>
  <ul class="mt-3 grid gap-3 sm:grid-cols-2">
    {
      offering.coaches.map((c) => (
        <li>
          <a
            href={`/s/${c.typeId}`}
            class="flex h-full flex-col rounded-xl border border-line bg-white p-4 transition-colors hover:border-ink"
          >
            <span class="font-display text-lg font-bold">{c.name}</span>
            <span class="mt-1 text-sm font-semibold text-ink-soft">{priceFor(c)}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    offering.kind === 'appointment' && pool.length > 0 && (
      <>
        <p class="eyebrow mt-10">Or take the first opening</p>
        <p class="mt-1 text-sm text-ink-soft">We'll match you with whichever coach is free.</p>

        <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          {offering.durations.length > 1 ? (
            <div class="flex gap-2">
              {offering.durations.map((n) => (
                <a
                  href={`/g/${offering.slug}?${q({ dur: String(n) })}`}
                  class:list={[
                    'rounded-lg border px-3 py-1.5 text-sm',
                    n === dur ? 'border-ink bg-ink text-paper' : 'border-line bg-white hover:border-ink',
                  ]}
                >
                  {n} min
                </a>
              ))}
            </div>
          ) : (
            <p class="eyebrow">{dur} min</p>
          )}
          <form method="GET" class="flex items-center gap-1.5 text-xs text-ink-soft">
            <input type="hidden" name="dur" value={dur} />
            <label class="whitespace-nowrap">Jump to</label>
            <input
              type="date"
              name="date"
              value={date}
              min={today}
              max={maxDate}
              onchange="this.form.submit()"
              class="field w-40"
            />
          </form>
        </div>

        <div class="mt-3 grid grid-cols-7 gap-px overflow-hidden rounded-xl border border-line bg-line">
          {rail.map((r) => (
            <a
              href={`/g/${offering.slug}?${q({ date: r.date })}`}
              class:list={[
                'flex flex-col items-center gap-1 bg-paper py-3 transition-colors hover:bg-white',
                r.isSelected && 'bg-ink! text-paper hover:bg-ink!',
              ]}
              aria-current={r.isSelected ? 'date' : undefined}
                aria-label={calFmt(r.date, 'EEEE d MMMM')}
            >
              <span class="text-[11px] font-semibold uppercase tracking-wide opacity-70">{r.dow}</span>
              <span class="tnum font-display text-lg font-bold">{r.day}</span>
              <span class:list={['h-1.5 w-1.5 rounded-full', r.isToday ? 'bg-ball' : 'bg-transparent']} />
            </a>
          ))}
        </div>

        {merged.length === 0 ? (
          <p class="mt-8 border border-dashed border-line bg-white px-4 py-6 text-center text-sm text-ink-soft">
            No open times on {calFmt(date, 'EEEE')}. Try another day.
          </p>
        ) : (
          <div class="mt-6 grid grid-cols-2 overflow-hidden rounded-xl border-t border-l border-line sm:grid-cols-3 md:grid-cols-4">
            {merged.map((s) => (
              <a
                href={`/book?group=${offering.slug}&dur=${dur}&date=${date}&start_at=${encodeURIComponent(s.startAt)}`}
                class="border-r border-b border-line bg-paper px-4 py-5 text-center transition-colors hover:bg-ball focus-visible:bg-ball focus-visible:outline-none"
              >
                <span class="tnum font-display text-lg font-semibold">{fmtTime(s.startAt)}</span>
              </a>
            ))}
          </div>
        )}
      </>
    )
  }
</Base>
