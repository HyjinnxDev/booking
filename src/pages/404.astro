---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <h1 class="text-3xl font-extrabold sm:text-4xl">Page not found</h1>
  <p class="mt-3 text-ink-soft">That link doesn't go anywhere. It may have moved or expired.</p>
  <a href="/" class="mt-6 inline-block text-sm font-semibold text-ink underline underline-offset-2">
    Book a session
  </a>
</Base>
