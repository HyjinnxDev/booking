---
import Base from '../layouts/Base.astro';
import { SITE_URL } from '../lib/config';

let error = '';
let checkEmail = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const name = String(form.get('name') ?? '').trim();

  if (password.length < 8) {
    error = 'Password must be at least 8 characters.';
  } else {
    const { data, error: e } = await Astro.locals.supabase.auth.signUp({
      email,
      password,
      options: { data: { name }, emailRedirectTo: `${SITE_URL}/auth/callback` },
    });
    if (e) error = e.message;
    else if (data.session) return Astro.redirect(Astro.url.searchParams.get('next') || '/');
    else checkEmail = true;
  }
}
---

<Base title="Create an account">
  <div class="mx-auto max-w-sm">
    <h1 class="text-3xl font-extrabold">Create an account</h1>
    <p class="mt-2 text-sm text-ink-soft">
      You don't need this to book — just <a href="/" class="font-semibold text-ink underline underline-offset-2">book a
      session</a> and we'll set one up. This is for coaches and staff.
    </p>

    {error && <p class="mt-5 border-l-2 border-red-500 bg-white px-4 py-3 text-sm">{error}</p>}

    {
      checkEmail ? (
        <p class="mt-5 border-l-2 border-ball bg-white px-4 py-3 text-sm">
          Check your email for a confirmation link, then sign in.
        </p>
      ) : (
        <form method="POST" class="mt-6 flex flex-col gap-4">
          <label class="text-sm">
            <span class="font-semibold">Name</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 focus:border-ink focus:outline-none"
            />
          </label>
          <label class="text-sm">
            <span class="font-semibold">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 focus:border-ink focus:outline-none"
            />
          </label>
          <label class="text-sm">
            <span class="font-semibold">Password</span>
            <input
              type="password"
              name="password"
              required
              minlength="8"
              autocomplete="new-password"
              class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 focus:border-ink focus:outline-none"
            />
          </label>
          <button class="w-fit rounded-lg bg-ink px-5 py-2.5 text-sm font-semibold text-paper hover:opacity-90">
            Sign up
          </button>
        </form>
      )
    }

    <p class="mt-6 text-sm text-ink-soft">
      Already have an account? <a href="/login" class="font-semibold text-ink underline underline-offset-2">Sign in</a>
    </p>
  </div>
</Base>
