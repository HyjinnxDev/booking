---
import Base from '../../layouts/Base.astro';

// Auth-required (middleware guards /account). Reached from the "set a password"
// link (recovery session) or from "My bookings" while already signed in.
const { locals, request } = Astro;
let error = '';
let done = false;

if (request.method === 'POST') {
  const form = await request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password.length < 8) error = 'Use at least 8 characters.';
  else if (password !== confirm) error = 'The two passwords don’t match.';
  else {
    const { error: e } = await locals.supabase.auth.updateUser({ password });
    if (e) error = e.message;
    else done = true;
  }
}
---

<Base title="Set a password">
  <div class="mx-auto max-w-sm">
    <h1 class="text-3xl font-extrabold">Set a password</h1>

    {done ? (
      <>
        <p class="mt-5 border-l-2 border-ball bg-white px-4 py-3 text-sm">Password saved.</p>
        <a href="/bookings" class="mt-6 inline-block text-sm font-semibold text-ink underline underline-offset-2">
          Go to my bookings
        </a>
      </>
    ) : (
      <>
        <p class="mt-2 text-sm text-ink-soft">Pick something you'll remember — you'll use it to sign in.</p>
        {error && <p class="mt-5 border-l-2 border-red-500 bg-white px-4 py-3 text-sm" role="alert">{error}</p>}
        <form method="POST" class="mt-6 flex flex-col gap-4">
          <label class="text-sm">
            <span class="font-semibold">New password</span>
            <input type="password" name="password" required minlength="8" autocomplete="new-password" class="field mt-1" />
          </label>
          <label class="text-sm">
            <span class="font-semibold">Confirm</span>
            <input type="password" name="confirm" required minlength="8" autocomplete="new-password" class="field mt-1" />
          </label>
          <button class="w-fit rounded-lg bg-ink px-5 py-2.5 text-sm font-semibold text-paper hover:opacity-90">
            Save password
          </button>
        </form>
      </>
    )}
  </div>
</Base>
