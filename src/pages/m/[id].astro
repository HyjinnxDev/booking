---
import Base from '../../layouts/Base.astro';
import { getCoachProfile } from '../../lib/coach';
import { getAvailableSlots } from '../../lib/slots';
import { getVariant } from '../../lib/sessions';
import { createSupabaseAdmin } from '../../lib/supabase';
import { sendReschedule, sendCancellation, sendCoachNotice } from '../../lib/email';
import { notifyWaitlist } from '../../lib/waitlist';
import { fmtTime, fmtLong, fmtPrice, todayStr, addDaysStr, calFmt, localDay } from '../../lib/format';
import { getSettings } from '../../lib/settings';
import { listCoaches } from '../../lib/staff';

// Manage one booking. The booking id in the URL is the capability token, holding
// the link (from the confirmation email, or from /bookings) is what authorises
// reschedule + cancel. No login required; that's the point.
const { params, url, redirect, request, locals } = Astro;
const id = params.id ?? '';
const db = createSupabaseAdmin();

const { data: booking } = await db
  .from('bookings')
  .select(
    `id, coach_id, start_at, end_at, status, notes, ics_sequence, price_cents, payment_status, pass_id,
     class_occurrence_id, session_variant_id,
     client:client_id ( name, email )`,
  )
  .eq('id', id)
  .maybeSingle();

const done = url.searchParams.get('done'); // 'cancelled' | 'rescheduled' | 'booked' | 'reassigned'
const settings = await getSettings();
const coach = booking ? await getCoachProfile(booking.coach_id) : null;
const isStaff = locals.profile?.role === 'coach' || locals.profile?.role === 'admin';
const isAdmin = locals.profile?.role === 'admin';
const backToApp = !!locals.user;

// Where to send a logged-in user after an action. Staff manage clients' bookings,
// so they go back to the dashboard, not their own (empty) bookings list.
const afterAction = (verb: 'cancelled' | 'rescheduled' | 'reassigned') =>
  isAdmin ? `/admin?${verb}=1` : isStaff ? `/coach?${verb}=1` : backToApp ? `/bookings?${verb}=1` : `/m/${id}?done=${verb}`;

const isAppointment = booking ? !booking.class_occurrence_id && !!booking.session_variant_id : false;
const variant = booking?.session_variant_id ? await getVariant(booking.session_variant_id) : null;

const cancelled = booking?.status !== 'confirmed'; // cancelled or no_show
const past = booking ? new Date(booking.start_at).getTime() <= Date.now() : true;
// §2.7: one lock for both client reschedule AND cancel, so you can't dodge the
// cancel cutoff by rescheduling far out first. lock = max(min-notice, cancel-cutoff).
const cutoffH = (variant?.type as any)?.cancel_cutoff_hours ?? 0;
const clientLockMs = Math.max(settings.minNoticeMin * 60_000, cutoffH * 3600_000);
const clientLocked = booking
  ? new Date(booking.start_at).getTime() <= Date.now() + clientLockMs
  : true;
// Staff bypass every "too close / already passed" lock, they field the phone call
// at 9am to move a 10am booking, or clean up a no-show.
const canCancel = !!booking && !cancelled && (isStaff || (!past && !clientLocked));
const canReschedule =
  !!booking && isAppointment && !!variant && !cancelled && (isStaff || !clientLocked);

const today = todayStr();
const maxDate = addDaysStr(today, settings.bookingWindowDays);
let date = url.searchParams.get('date') || today;
if (date < today) date = today;
if (date > maxDate) date = maxDate;

const client = (booking?.client ?? {}) as { name?: string; email?: string };

let error = '';
if (booking && request.method === 'POST' && !cancelled) {
  const form = await request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'cancel') {
    if (!canCancel) {
      // §2.15: /bookings shows Cancel for everything; say why nothing happened.
      error = 'Too close to the session to cancel online. Contact your coach.';
    } else {
      const nextSeq = (booking.ics_sequence ?? 0) + 1;
      const { data: c } = await db
        .from('bookings')
        .update({
          status: 'cancelled',
          ics_sequence: nextSeq,
          cancelled_at: new Date().toISOString(),
          cancelled_by: isStaff ? 'staff' : 'client',
        })
        .eq('id', booking.id)
        .eq('status', 'confirmed')
        .select('id')
        .maybeSingle();
      if (c) {
        if (booking.class_occurrence_id) {
          try {
            await notifyWaitlist(booking.class_occurrence_id);
          } catch (e) {
            console.error('waitlist notify failed', e);
          }
        }
        if (client.email) {
          try {
            await sendCancellation({
              to: client.email,
              clientName: client.name ?? '',
              coachName: coach?.name ?? 'your coach',
              bookingId: booking.id,
              startAt: booking.start_at,
              endAt: booking.end_at,
              notes: booking.notes,
              typeName: variant?.type?.name,
              locationName: (variant?.type as any)?.location?.name,
              locationAddress: (variant?.type as any)?.location?.address,
              sequence: booking.ics_sequence ?? 0,
            });
          } catch (e) {
            console.error('cancellation email failed', e);
          }
        }
        // §3.2: tell the coach when the client cancels (not when staff do it).
        if (!isStaff && coach?.email) {
          try {
            await sendCoachNotice({
              to: coach.email,
              coachName: coach.name ?? '',
              kind: 'cancelled',
              clientName: client.name ?? '',
              startAt: booking.start_at,
              typeName: variant?.type?.name ?? 'Session',
              bookingId: booking.id,
            });
          } catch (e) {
            console.error('coach notice failed', e);
          }
        }
        return redirect(afterAction('cancelled'));
      }
      error = 'That booking could not be cancelled.';
    }
  }

  if (action === 'reschedule' && canReschedule) {
    const startAt = String(form.get('start_at') ?? '');
    const d = String(form.get('date') ?? '');
    const inWindow = !!d && d >= today && d <= maxDate;
    const open =
      inWindow &&
      (await getAvailableSlots(booking.coach_id, d, variant!.duration_min)).some((s) => s.startAt === startAt);

    if (!open) {
      error = 'That time is no longer open. Pick another.';
    } else {
      const endAt = new Date(new Date(startAt).getTime() + variant!.duration_min * 60_000).toISOString();
      const nextSeq = (booking.ics_sequence ?? 0) + 1;
      const { error: e } = await db
        .from('bookings')
        .update({ start_at: startAt, end_at: endAt, reminded_at: null, ics_sequence: nextSeq })
        .eq('id', booking.id)
        .eq('status', 'confirmed');
      if (e) {
        error =
          e.code === '23505' || e.code === '23P01'
            ? 'That time was just taken. Pick another.'
            : 'Could not move the booking.';
      } else {
        if (client.email) {
          try {
            await sendReschedule({
              to: client.email,
              clientName: client.name ?? '',
              coachName: coach?.name ?? 'your coach',
              bookingId: booking.id,
              startAt,
              endAt,
              notes: booking.notes,
              typeName: variant?.type?.name,
              locationName: (variant?.type as any)?.location?.name,
              locationAddress: (variant?.type as any)?.location?.address,
              sequence: nextSeq,
              reason: 'moved',
            });
          } catch (err) {
            console.error('reschedule email failed', err);
          }
        }
        if (!isStaff && coach?.email) {
          try {
            await sendCoachNotice({
              to: coach.email,
              coachName: coach.name ?? '',
              kind: 'moved',
              clientName: client.name ?? '',
              startAt,
              typeName: variant?.type?.name ?? 'Session',
              bookingId: booking.id,
            });
          } catch (err) {
            console.error('coach notice failed', err);
          }
        }
        return redirect(afterAction('rescheduled'));
      }
    }
  }

  // Admin only: hand an appointment to a different coach, same time.
  if (action === 'reassign' && isAdmin && isAppointment && !past && !booking.pass_id) {
    const newCoachId = String(form.get('coach_id') ?? '');
    const dur = variant!.duration_min;
    const { data: v2 } = await db
      .from('session_variants')
      .select('id, price_cents, session_types!inner ( coach_id, kind, active )')
      .eq('active', true)
      .eq('duration_min', dur)
      .eq('session_types.coach_id', newCoachId)
      .eq('session_types.kind', 'appointment')
      .eq('session_types.active', true)
      .limit(1)
      .maybeSingle();

    if (!newCoachId || newCoachId === booking.coach_id) {
      error = 'Pick a different coach.';
    } else if (!v2) {
      error = 'That coach has no matching session at this length.';
    } else if (
      !(await getAvailableSlots(newCoachId, localDay(booking.start_at), dur)).some((s) => s.startAt === booking.start_at)
    ) {
      error = 'That coach is not free at this time.';
    } else {
      const nextSeq = (booking.ics_sequence ?? 0) + 1;
      const repriced =
        booking.payment_status === 'unpaid' || booking.payment_status === 'free'
          ? { price_cents: v2.price_cents, payment_status: v2.price_cents === 0 ? 'free' : 'unpaid' }
          : {};
      const { error: e } = await db
        .from('bookings')
        .update({ coach_id: newCoachId, session_variant_id: v2.id, reminded_at: null, ics_sequence: nextSeq, ...repriced })
        .eq('id', booking.id)
        .eq('status', 'confirmed');
      if (e) {
        error =
          e.code === '23505' || e.code === '23P01'
            ? 'That coach was just booked then.'
            : 'Could not reassign.';
      } else {
        const nc = await getCoachProfile(newCoachId);
        if (client.email) {
          try {
            await sendReschedule({
              to: client.email,
              clientName: client.name ?? '',
              coachName: nc?.name ?? 'your coach',
              bookingId: booking.id,
              startAt: booking.start_at,
              endAt: booking.end_at,
              notes: booking.notes,
              typeName: variant?.type?.name,
              locationName: (variant?.type as any)?.location?.name,
              locationAddress: (variant?.type as any)?.location?.address,
              sequence: nextSeq,
              reason: 'reassigned',
            });
          } catch (err) {
            console.error('reassign email failed', err);
          }
        }
        // §3.2: the new coach inherits the booking.
        if (nc?.email) {
          try {
            await sendCoachNotice({
              to: nc.email,
              coachName: nc.name ?? '',
              kind: 'reassigned',
              clientName: client.name ?? '',
              startAt: booking.start_at,
              typeName: variant?.type?.name ?? 'Session',
              bookingId: booking.id,
            });
          } catch (err) {
            console.error('coach notice failed', err);
          }
        }
        return redirect(afterAction('reassigned'));
      }
    }
  }
}

const reassignCoaches =
  isAdmin && isAppointment && !cancelled && !past && !booking?.pass_id
    ? (await listCoaches({ activeOnly: true })).filter((c) => c.id !== booking!.coach_id)
    : [];

const showPicker = canReschedule && url.searchParams.get('reschedule') === '1';
const slots = showPicker ? await getAvailableSlots(booking!.coach_id, date, variant!.duration_min) : [];
const rail = Array.from({ length: 7 }, (_, i) => {
  const dd = addDaysStr(today, i);
  return { date: dd, dow: calFmt(dd, 'EEE'), day: calFmt(dd, 'd'), isToday: dd === today, isSelected: dd === date };
});

const title = booking ? 'Manage your booking' : 'Booking not found';
---

<Base title={title}>
  {backToApp && (
    <a href={isStaff ? '/coach' : '/bookings'} class="text-sm text-ink-soft hover:text-ink">
      ← {isStaff ? 'Dashboard' : 'My bookings'}
    </a>
  )}

  {
    !booking ? (
      <>
        <h1 class="mt-3 text-3xl font-extrabold sm:text-4xl">Booking not found</h1>
        <p class="mt-3 text-ink-soft">
          This link doesn't match a booking. It may have been cancelled already.
        </p>
        <a href="/" class="mt-6 inline-block text-sm font-semibold text-ink underline underline-offset-2">
          Book a session
        </a>
      </>
    ) : (
      <>
        <h1 class="mt-3 text-3xl font-extrabold sm:text-4xl">
          {done === 'booked' ? "You're booked" : done === 'cancelled' ? 'Booking cancelled' : 'Your booking'}
        </h1>

        {done === 'booked' && (
          <p class="mt-3 border-l-2 border-ball bg-white px-4 py-3 text-sm">
            Confirmation and a calendar invite are on their way to your email.
            {url.searchParams.get('new') === '1' && (
              <span> We also set up an account. There is a link in that email to set a password so you can manage this booking any time.</span>
            )}
          </p>
        )}
        {done === 'rescheduled' && (
          <p class="mt-3 border-l-2 border-ball bg-white px-4 py-3 text-sm">
            Moved. A calendar update is on its way.
          </p>
        )}
        {done === 'reassigned' && (
          <p class="mt-3 border-l-2 border-ball bg-white px-4 py-3 text-sm">
            Reassigned. The client has been emailed.
          </p>
        )}
        {done === 'cancelled' && (
          <p class="mt-3 border-l-2 border-ink bg-white px-4 py-3 text-sm">
            This booking is cancelled. Book again whenever you like.
          </p>
        )}
        {error && <p class="mt-3 border-l-2 border-red-500 bg-white px-4 py-3 text-sm" role="alert">{error}</p>}

        <div class="mt-6 border-l-2 border-ball bg-white px-4 py-4">
          <p class:list={['tnum font-display text-xl font-bold', cancelled && 'line-through opacity-60']}>
            {fmtLong(booking.start_at)}
          </p>
          <p class="mt-1 text-sm text-ink-soft">
            {variant?.type?.name ?? 'Session'}
            {variant ? ` · ${variant.name}` : ''} · {coach?.name ?? 'your coach'} · {fmtPrice(booking.price_cents ?? 0)}
          </p>
          {variant?.type?.location && (
            <p class="mt-1 text-sm text-ink-soft">
              📍 {variant.type.location.name}
              {variant.type.location.address && (
                <>
                  {' · '}
                  <a
                    href={`https://maps.google.com/?q=${encodeURIComponent(variant.type.location.address)}`}
                    class="underline underline-offset-2 hover:text-ink"
                    target="_blank"
                    rel="noopener"
                  >
                    {variant.type.location.address}
                  </a>
                </>
              )}
            </p>
          )}
        </div>

        {
          !cancelled && (past && !isStaff ? (
            <p class="mt-6 text-sm text-ink-soft">This session has passed.</p>
          ) : (
            <div class="mt-6 flex flex-wrap gap-3">
              {past && isStaff && (
                <span class="w-full text-xs text-ink-soft">This session has already passed.</span>
              )}
              {isAppointment &&
                (canReschedule ? (
                  <a
                    href={`/m/${booking.id}?reschedule=1`}
                    class="rounded-lg border border-ink px-4 py-2 text-sm font-semibold hover:bg-ink hover:text-paper"
                  >
                    Reschedule
                  </a>
                ) : isStaff ? null : (
                  <span class="text-sm text-ink-soft">Too close to the session to reschedule online. Contact {coach?.name ?? 'your coach'}.</span>
                ))}
              {canCancel ? (
                <form method="POST" onsubmit="return confirm('Cancel this booking?')">
                  <input type="hidden" name="action" value="cancel" />
                  <button class="rounded-lg border border-line px-4 py-2 text-sm hover:border-ink">Cancel booking</button>
                </form>
              ) : !isStaff && !past && clientLocked ? (
                <span class="text-sm text-ink-soft">
                  Too close to the session to cancel online. Contact {coach?.name ?? 'your coach'}.
                </span>
              ) : null}

              {reassignCoaches.length > 0 && (
                <form method="POST" class="flex items-center gap-2">
                  <input type="hidden" name="action" value="reassign" />
                  <select name="coach_id" class="field w-40">
                    {reassignCoaches.map((c) => (
                      <option value={c.id}>{c.name || c.email}</option>
                    ))}
                  </select>
                  <button class="rounded-lg border border-line px-4 py-2 text-sm hover:border-ink">Reassign coach</button>
                </form>
              )}
            </div>
          ))
        }

        {
          showPicker && (
            <div class="mt-10">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                <p class="eyebrow">{calFmt(date, 'EEEE d MMMM')} · {variant!.duration_min} min</p>
                <form method="GET" class="flex items-center gap-1.5 text-xs text-ink-soft">
                  <input type="hidden" name="reschedule" value="1" />
                  <label class="whitespace-nowrap">Jump to</label>
                  <input
                    type="date"
                    name="date"
                    value={date}
                    min={today}
                    max={maxDate}
                    onchange="this.form.submit()"
                    class="field w-40"
                  />
                  <noscript><button class="btn btn-ghost btn-sm">Go</button></noscript>
                </form>
              </div>

              <div class="mt-3 grid grid-cols-7 gap-px overflow-hidden rounded-xl border border-line bg-line">
                {rail.map((r) => (
                  <a
                    href={`/m/${booking.id}?${new URLSearchParams({ reschedule: '1', date: r.date }).toString()}`}
                    class:list={[
                      'flex flex-col items-center gap-1 bg-paper py-3 transition-colors hover:bg-white',
                      r.isSelected && 'bg-ink! text-paper hover:bg-ink!',
                    ]}
                    aria-current={r.isSelected ? 'date' : undefined}
                aria-label={calFmt(r.date, 'EEEE d MMMM')}
                  >
                    <span class="text-[11px] font-semibold uppercase tracking-wide opacity-70">{r.dow}</span>
                    <span class="tnum font-display text-lg font-bold">{r.day}</span>
                    <span class:list={['h-1.5 w-1.5 rounded-full', r.isToday ? 'bg-ball' : 'bg-transparent']} />
                  </a>
                ))}
              </div>

              {slots.length === 0 ? (
                <p class="mt-8 border border-dashed border-line bg-white px-4 py-6 text-center text-sm text-ink-soft">
                  No open times on {calFmt(date, 'EEEE')}. Try another day.
                </p>
              ) : (
                <>
                  <p class="eyebrow mt-8">Pick a new time</p>
                  <div class="mt-3 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-3 md:grid-cols-4">
                    {slots.map((s) => (
                      <form method="POST">
                        <input type="hidden" name="action" value="reschedule" />
                        <input type="hidden" name="date" value={date} />
                        <input type="hidden" name="start_at" value={s.startAt} />
                        <button
                          type="submit"
                          class="w-full bg-paper px-4 py-5 text-center transition-colors hover:bg-ball focus-visible:bg-ball focus-visible:outline-none"
                        >
                          <span class="tnum font-display text-lg font-semibold">{fmtTime(s.startAt)}</span>
                        </button>
                      </form>
                    ))}
                  </div>
                </>
              )}
            </div>
          )
        }
      </>
    )
  }
</Base>
