---
import Base from '../layouts/Base.astro';
import { fmtLong } from '../lib/format';

const { locals, url } = Astro;
const user = locals.user!; // middleware guarantees auth on /bookings

const { data: rows } = await locals.supabase
  .from('bookings')
  .select('id, start_at, end_at, status, notes')
  .eq('client_id', user.id)
  .order('start_at', { ascending: true });

const now = Date.now();
const bookings = rows ?? [];
const upcoming = bookings.filter((b) => new Date(b.start_at).getTime() > now && b.status === 'confirmed');
const past = bookings.filter((b) => !(new Date(b.start_at).getTime() > now && b.status === 'confirmed'));

const cancelled = url.searchParams.get('cancelled') === '1';
const booked = url.searchParams.get('booked') === '1';
---

<Base title="My bookings">
  <h1 class="text-xl font-semibold">My bookings</h1>

  {booked && <p class="mt-3 rounded bg-green-50 px-3 py-2 text-sm text-green-800">Booking confirmed.</p>}
  {cancelled && <p class="mt-3 rounded bg-neutral-100 px-3 py-2 text-sm">Booking cancelled.</p>}

  <h2 class="mt-6 text-sm font-semibold text-neutral-500 uppercase">Upcoming</h2>
  {
    upcoming.length === 0 ? (
      <p class="mt-2 text-neutral-600">
        Nothing booked. <a href="/" class="underline">Book a session</a>.
      </p>
    ) : (
      <ul class="mt-2 divide-y divide-neutral-200 rounded border border-neutral-200 bg-white">
        {upcoming.map((b) => (
          <li class="flex items-center justify-between gap-4 px-4 py-3">
            <div>
              <p class="font-medium">{fmtLong(b.start_at)}</p>
              {b.notes && <p class="text-sm text-neutral-500">{b.notes}</p>}
            </div>
            <form method="POST" action="/api/bookings">
              <input type="hidden" name="action" value="cancel" />
              <input type="hidden" name="id" value={b.id} />
              <button class="rounded border border-red-300 px-3 py-1 text-sm text-red-700 hover:bg-red-50">
                Cancel
              </button>
            </form>
          </li>
        ))}
      </ul>
    )
  }

  {
    past.length > 0 && (
      <>
        <h2 class="mt-8 text-sm font-semibold text-neutral-500 uppercase">Past &amp; cancelled</h2>
        <ul class="mt-2 divide-y divide-neutral-200 rounded border border-neutral-200 bg-white">
          {past.map((b) => (
            <li class="flex items-center justify-between gap-4 px-4 py-3 text-neutral-500">
              <p>{fmtLong(b.start_at)}</p>
              <span class="text-xs uppercase">{b.status === 'cancelled' ? 'cancelled' : 'past'}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>
