---
import Base from '../layouts/Base.astro';
import { fmtLong } from '../lib/format';

const { locals, url } = Astro;
const user = locals.user!; // middleware guarantees auth on /bookings

const { data: rows } = await locals.supabase
  .from('bookings')
  .select('id, start_at, end_at, status, notes, class_occurrence_id')
  .eq('client_id', user.id)
  .order('start_at', { ascending: true });

const now = Date.now();
const bookings = rows ?? [];
const upcoming = bookings.filter((b) => new Date(b.start_at).getTime() > now && b.status === 'confirmed');
const past = bookings.filter((b) => !(new Date(b.start_at).getTime() > now && b.status === 'confirmed'));

const cancelled = url.searchParams.get('cancelled') === '1';
const booked = url.searchParams.get('booked') === '1';
const rescheduled = url.searchParams.get('rescheduled') === '1';
---

<Base title="My bookings">
  <h1 class="text-3xl font-extrabold sm:text-4xl">My bookings</h1>

  {
    booked && (
      <p class="mt-5 border-l-2 border-ball bg-white px-4 py-3 text-sm">Booked. Confirmation is on its way.</p>
    )
  }
  {cancelled && <p class="mt-5 border-l-2 border-ink bg-white px-4 py-3 text-sm">Booking cancelled.</p>}
  {rescheduled && <p class="mt-5 border-l-2 border-ball bg-white px-4 py-3 text-sm">Booking moved. A calendar update is on its way.</p>}

  <p class="mt-8 font-display text-sm font-semibold uppercase tracking-wider text-ink-soft">Upcoming</p>
  {
    upcoming.length === 0 ? (
      <p class="mt-3 text-sm text-ink-soft">
        Nothing booked. <a href="/" class="font-semibold text-ink underline underline-offset-2">Book a session</a>.
      </p>
    ) : (
      <ul class="mt-3 divide-y divide-line overflow-hidden rounded-xl border border-line bg-white">
        {upcoming.map((b) => (
          <li class="flex items-center justify-between gap-4 px-4 py-4">
            <div>
              <p class="tnum font-display font-bold">{fmtLong(b.start_at)}</p>
              {b.notes && <p class="mt-0.5 text-sm text-ink-soft">{b.notes}</p>}
            </div>
            <div class="flex shrink-0 items-center gap-2">
              {!b.class_occurrence_id && (
                <a
                  href={`/m/${b.id}?reschedule=1`}
                  class="rounded-lg border border-line px-3 py-1.5 text-sm hover:border-ink"
                >
                  Reschedule
                </a>
              )}
              <form method="POST" action={`/m/${b.id}`} onsubmit="return confirm('Cancel this booking?')">
                <input type="hidden" name="action" value="cancel" />
                <button class="rounded-lg border border-line px-3 py-1.5 text-sm hover:border-ink">Cancel</button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  {
    past.length > 0 && (
      <>
        <p class="mt-10 font-display text-sm font-semibold uppercase tracking-wider text-ink-soft">Past &amp; cancelled</p>
        <ul class="mt-3 divide-y divide-line overflow-hidden rounded-xl border border-line bg-white text-ink-soft">
          {past.map((b) => (
            <li class="flex items-center justify-between gap-4 px-4 py-3">
              <p class="tnum text-sm">{fmtLong(b.start_at)}</p>
              <span class="text-[11px] font-semibold uppercase tracking-wide">
                {b.status === 'cancelled' ? 'cancelled' : 'done'}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>
