---
import Base from '../layouts/Base.astro';
import { getCoachProfile } from '../lib/coach';
import { getAvailableSlots, mergeAvailability, pickCoach } from '../lib/slots';
import { getVariant, getOccurrence, getSessionTypeById } from '../lib/sessions';
import { getOffering } from '../lib/offerings';
import { createSupabaseAdmin } from '../lib/supabase';
import { findOrCreateClient } from '../lib/accounts';
import { sendConfirmation } from '../lib/email';
import { fmtLong, fmtPrice, todayStr, addDaysStr } from '../lib/format';
import { getSettings } from '../lib/settings';
import { parseIntakeFields, collectIntake, type IntakeField } from '../lib/intake';
import { activePassesForClient, passCovers } from '../lib/passes';

const { locals, url, redirect, request } = Astro;
const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

const variantId = url.searchParams.get('variant') ?? '';
const occId = url.searchParams.get('occ') ?? '';
const groupSlug = url.searchParams.get('group') ?? '';
const groupDur = Number(url.searchParams.get('dur')) || 0;
const startAtParam = url.searchParams.get('start_at') ?? '';
const date = url.searchParams.get('date') ?? '';

// Resolve what's being booked into a common shape.
interface BookCtx {
  kind: 'appointment' | 'class';
  coachId: string;
  coachName: string;
  typeId: string;
  typeName: string;
  variantId: string;
  variantName: string;
  durationMin: number;
  priceCents: number;
  startAt: string;
  endAt: string;
  occId?: string;
  locationName?: string;
  locationAddress?: string | null;
  intakeFields: IntakeField[];
}

let ctx: BookCtx | null = null;

const settings = await getSettings();
const noticeCutoff = Date.now() + settings.minNoticeMin * 60_000;
const maxDate = addDaysStr(todayStr(), settings.bookingWindowDays);
const dateOk = !!date && date >= todayStr() && date <= maxDate;

if (occId) {
  const occ = await getOccurrence(occId);
  if (!occ || new Date(occ.start_at).getTime() <= noticeCutoff) return redirect('/?error=slot_taken');
  if (occ.seats_taken >= occ.capacity) return redirect(`/s/${occ.type.id}?error=full`);
  const coach = await getCoachProfile(occ.type.coach_id);
  ctx = {
    kind: 'class',
    coachId: occ.type.coach_id,
    coachName: coach?.name ?? 'your coach',
    typeId: occ.type.id,
    typeName: occ.type.name,
    variantId: occ.variant.id,
    variantName: occ.variant.name,
    durationMin: occ.variant.duration_min,
    priceCents: occ.variant.price_cents,
    startAt: occ.start_at,
    endAt: occ.end_at,
    occId: occ.id,
    locationName: occ.type.location?.name,
    locationAddress: occ.type.location?.address,
    intakeFields: parseIntakeFields(occ.type.intake_fields),
  };
} else if (variantId) {
  const v = await getVariant(variantId);
  if (!v || !v.active || v.type.kind !== 'appointment') return redirect('/');
  const open =
    dateOk && (await getAvailableSlots(v.type.coach_id, date, v.duration_min)).some((s) => s.startAt === startAtParam);
  if (!startAtParam || !open) return redirect(`/s/${v.type.id}?variant=${v.id}&date=${date || ''}&error=slot_taken`);
  const coach = await getCoachProfile(v.type.coach_id);
  ctx = {
    kind: 'appointment',
    coachId: v.type.coach_id,
    coachName: coach?.name ?? 'your coach',
    typeId: v.type.id,
    typeName: v.type.name,
    variantId: v.id,
    variantName: v.name,
    durationMin: v.duration_min,
    priceCents: v.price_cents,
    startAt: startAtParam,
    endAt: new Date(new Date(startAtParam).getTime() + v.duration_min * 60_000).toISOString(),
    locationName: v.type.location?.name,
    locationAddress: v.type.location?.address,
    intakeFields: parseIntakeFields(v.type.intake_fields),
  };
} else if (groupSlug && groupDur) {
  // "Any available coach" — resolve a coach + their matching variant for this slot.
  const offering = await getOffering(groupSlug);
  if (!offering || offering.kind !== 'appointment') return redirect('/');
  const pool = offering.coaches.filter((c) => c.variants.some((v) => v.duration_min === groupDur));
  const back = `/g/${groupSlug}?dur=${groupDur}&date=${date || ''}`;
  const merged = dateOk ? await mergeAvailability(pool.map((c) => c.id), date, groupDur) : [];
  const slot = merged.find((m) => m.startAt === startAtParam);
  if (!startAtParam || !slot) return redirect(`${back}&error=slot_taken`);
  const coachId = await pickCoach(slot.coachIds, startAtParam);
  const picked = pool.find((c) => c.id === coachId)!;
  const variant = picked.variants.find((v) => v.duration_min === groupDur)!;
  const [coach, pickedType] = await Promise.all([getCoachProfile(coachId), getSessionTypeById(picked.typeId)]);
  ctx = {
    kind: 'appointment',
    coachId,
    coachName: coach?.name ?? 'your coach',
    typeId: picked.typeId,
    typeName: offering.name,
    variantId: variant.id,
    variantName: variant.name,
    durationMin: variant.duration_min,
    priceCents: variant.price_cents,
    startAt: startAtParam,
    endAt: new Date(new Date(startAtParam).getTime() + groupDur * 60_000).toISOString(),
    locationName: offering.location?.name,
    locationAddress: offering.location?.address,
    intakeFields: parseIntakeFields(pickedType?.intake_fields),
  };
} else {
  return redirect('/');
}

const loggedIn = !!locals.user;
let values = { name: locals.profile?.name ?? '', email: locals.user?.email ?? '', phone: '', notes: '' };
let error = '';
let intakeAnswers: Record<string, string | boolean> = {};
let chosenPassId = '';

const myPasses = loggedIn
  ? (await activePassesForClient(locals.user!.id)).filter((p) => passCovers(p, ctx.typeId))
  : [];

async function createBooking(clientId: string, to: string, name: string, tempPassword?: string) {
  const db = createSupabaseAdmin();
  const c = ctx!;
  const usePass = chosenPassId && myPasses.some((p) => p.id === chosenPassId);
  const { data, error: e } = await db
    .from('bookings')
    .insert({
      coach_id: c.coachId,
      client_id: clientId,
      start_at: c.startAt,
      end_at: c.endAt,
      status: 'confirmed',
      notes: values.notes || null,
      session_variant_id: c.variantId,
      class_occurrence_id: c.occId ?? null,
      price_cents: c.priceCents,
      payment_status: c.priceCents === 0 ? 'free' : 'unpaid',
      intake: Object.keys(intakeAnswers).length ? intakeAnswers : null,
      pass_id: usePass ? chosenPassId : null,
    })
    .select('id')
    .single();

  if (e) {
    if (e.code === '23514') {
      error = "That pass couldn't be applied — go back and book without it.";
      return null;
    }
    if (e.code === '23505') {
      error =
        c.kind === 'class'
          ? 'That class just filled up, or you already have a seat. Go back and pick another.'
          : 'That time was just booked by someone else. Go back and pick another.';
      return null;
    }
    throw e;
  }

  try {
    await sendConfirmation({
      to,
      clientName: name,
      coachName: c.coachName,
      bookingId: data.id,
      startAt: c.startAt,
      endAt: c.endAt,
      notes: values.notes || null,
      newAccount: tempPassword ? { tempPassword } : undefined,
    });
  } catch (err) {
    console.error('confirmation email failed', err);
  }

  return redirect(loggedIn ? '/bookings?booked=1' : `/booked?new=${tempPassword ? 1 : 0}`);
}

if (request.method === 'POST') {
  const form = await request.formData();
  values = {
    name: String(form.get('name') ?? '').trim(),
    email: String(form.get('email') ?? '').trim(),
    phone: String(form.get('phone') ?? '').trim(),
    notes: String(form.get('notes') ?? '').trim().slice(0, 500),
  };

  if (String(form.get('website') ?? '')) {
    return redirect('/booked?new=0'); // silently drop bots (honeypot filled)
  }

  const intake = collectIntake(ctx.intakeFields, form);
  intakeAnswers = intake.answers;
  chosenPassId = String(form.get('pass_id') ?? '');
  if (intake.error) error = intake.error;
  else if (loggedIn) {
    const done = await createBooking(locals.user!.id, locals.user!.email!, values.name);
    if (done) return done;
  } else if (!values.name || !EMAIL_RE.test(values.email)) {
    error = 'Please enter your name and a valid email address.';
  } else {
    try {
      const acct = await findOrCreateClient({
        email: values.email,
        name: values.name,
        phone: values.phone || null,
      });
      const done = await createBooking(acct.id, values.email, values.name, acct.tempPassword);
      if (done) return done;
    } catch (e) {
      console.error('guest booking failed', e);
      error = 'We could not complete your booking. Please try again.';
    }
  }
}

const backHref = groupSlug
  ? `/g/${groupSlug}?dur=${groupDur}&date=${date}`
  : ctx.kind === 'class'
    ? `/s/${ctx.typeId}`
    : `/s/${ctx.typeId}?variant=${ctx.variantId}&date=${date}`;
---

<Base title="Confirm your booking">
  <a href={backHref} class="text-sm text-ink-soft hover:text-ink">← Back</a>

  <h1 class="mt-3 text-3xl font-extrabold">Confirm your booking</h1>

  <div class="mt-6 border-l-2 border-ball bg-white px-4 py-4">
    <p class="tnum font-display text-xl font-bold">{fmtLong(ctx.startAt)}</p>
    <p class="text-sm text-ink-soft">
      {ctx.typeName} ·
      {ctx.kind === 'appointment' ? ctx.variantName : `${ctx.durationMin} min`} ·
      {ctx.coachName} · {fmtPrice(ctx.priceCents)}
    </p>
    {ctx.locationName && (
      <p class="mt-1 text-sm text-ink-soft">
        📍 {ctx.locationName}{ctx.locationAddress ? ` · ${ctx.locationAddress}` : ''}
      </p>
    )}
    {ctx.priceCents > 0 && <p class="mt-1 text-xs text-ink-soft">Pay in person — we'll mark it off.</p>}
  </div>

  {error && <p class="mt-5 border-l-2 border-red-500 bg-white px-4 py-3 text-sm">{error}</p>}

  <form method="POST" class="mt-6 flex flex-col gap-4">
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    {
      loggedIn ? (
        <p class="text-sm text-ink-soft">
          Booking as <strong class="text-ink">{locals.user!.email}</strong>.
        </p>
      ) : (
        <>
          <label class="text-sm">
            <span class="font-semibold">Name</span>
            <input
              type="text"
              name="name"
              required
              value={values.name}
              autocomplete="name"
              class="field mt-1"
            />
          </label>
          <label class="text-sm">
            <span class="font-semibold">Email</span>
            <input
              type="email"
              name="email"
              required
              value={values.email}
              autocomplete="email"
              class="field mt-1"
            />
            <span class="mt-1 block text-xs text-ink-soft">
              Your confirmation goes here, and we'll set up an account so you can manage the booking.
            </span>
          </label>
          <label class="text-sm">
            <span class="font-semibold">Phone</span>
            <span class="text-ink-soft"> — optional</span>
            <input
              type="tel"
              name="phone"
              value={values.phone}
              autocomplete="tel"
              class="field mt-1"
            />
          </label>
        </>
      )
    }

    {
      ctx.intakeFields.map((f) =>
        f.type === 'checkbox' ? (
          <label class="flex items-start gap-2 text-sm">
            <input type="checkbox" name={`intake:${f.label}`} class="mt-0.5" />
            <span>
              {f.label}
              {f.required && <span class="text-red-500"> *</span>}
            </span>
          </label>
        ) : (
          <label class="text-sm">
            <span class="font-semibold">{f.label}</span>
            {f.required && <span class="text-red-500"> *</span>}
            {f.type === 'textarea' ? (
              <textarea
                name={`intake:${f.label}`}
                rows="2"
                maxlength="1000"
                class="field mt-1"
              />
            ) : (
              <input
                type="text"
                name={`intake:${f.label}`}
                maxlength="1000"
                class="field mt-1"
              />
            )}
          </label>
        ),
      )
    }

    {
      myPasses.length > 0 && (
        <label class="text-sm">
          <span class="font-semibold">Payment</span>
          <select
            name="pass_id"
            class="field mt-1"
          >
            <option value="">{ctx.priceCents > 0 ? `Pay in person — ${fmtPrice(ctx.priceCents)}` : 'No payment needed'}</option>
            {myPasses.map((p) => (
              <option value={p.id}>
                Use “{p.name}” — {p.total - p.used} of {p.total} left
              </option>
            ))}
          </select>
        </label>
      )
    }

    <label class="text-sm">
      <span class="font-semibold">Notes for {ctx.coachName}</span>
      <span class="text-ink-soft"> — optional</span>
      <textarea
        name="notes"
        rows="2"
        maxlength="500"
        placeholder="Injuries, focus areas, first lesson…"
        class="field mt-1"
        set:text={values.notes}
      />
    </label>

    <button class="mt-1 w-fit rounded-lg bg-ink px-5 py-2.5 text-sm font-semibold text-paper hover:opacity-90">
      Confirm booking
    </button>
  </form>
</Base>
